---
const year = new Date().getFullYear();
---

<section id="contact" class="border-t border-ink-200/60 py-24 md:py-32 dark:border-ink-800/60">
  <div class="noise-bg mx-auto max-w-3xl px-6 text-center">
    <p class="reveal font-mono text-sm text-accent-600 dark:text-accent-400">05 · Contact</p>
    <h2 class="reveal mt-3 text-3xl font-extrabold tracking-tight text-ink-950 sm:text-4xl dark:text-white">
      Let's build something <span class="gradient-text">reusable</span>.
    </h2>
    <p class="reveal mt-4 text-base text-ink-600 dark:text-ink-300">
      Open to new opportunities and interesting front-end problems. Based in Austin, TX — happy to talk remote roles too.
    </p>

    <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="mailto:gerrardf7@gmail.com"
        class="rounded-full bg-ink-950 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-ink-950/10 transition-transform hover:-translate-y-0.5 dark:bg-white dark:text-ink-950"
      >
        gerrardf7@gmail.com
      </a>
      <a
        href="https://www.linkedin.com/in/gerardfierro"
        target="_blank"
        rel="noreferrer"
        class="rounded-full border border-ink-300 px-6 py-3 text-sm font-semibold text-ink-800 transition-colors hover:border-accent-500 hover:text-accent-600 dark:border-ink-700 dark:text-ink-200 dark:hover:border-accent-400 dark:hover:text-accent-400"
      >
        LinkedIn
      </a>
    </div>
  </div>

  <footer class="mx-auto mt-20 max-w-5xl px-6">
    <div class="flex flex-col items-center justify-between gap-3 border-t border-ink-200/60 pt-6 text-xs text-ink-500 sm:flex-row dark:border-ink-800/60 dark:text-ink-400">
      <p>&copy; {year} Gerard Fierro. Built with Astro, Vue, and Tailwind CSS.</p>
      <a href="https://github.com/Gerfier/gfierro.dev" target="_blank" rel="noreferrer" class="transition-colors hover:text-accent-500">
        View source on GitHub
      </a>
    </div>
  </footer>
</section>
