---
const frameworks = [
  {
    name: "Vue.js (2 & 3)",
    level: 5,
    note: "Primary framework — 8+ years across component systems, state, and build tooling.",
  },
  {
    name: "React",
    level: 3,
    note: "Comfortable shipping production components and features when a project calls for it.",
  },
];

const groups = [
  {
    label: "Proficient",
    accent: true,
    items: ["JavaScript (ES6+)", "Vuetify", "Vuex", "Pinia", "GraphQL", "HTML5", "CSS3", "Vite", "Git", "Agile / Scrum"],
  },
  {
    label: "AI-assisted development",
    accent: true,
    items: ["Claude Code", "GitHub Copilot", "Gemini"],
  },
  {
    label: "Familiar",
    accent: false,
    items: ["Redux", "Node.js", "Express", "MongoDB", "Go", "OpenAPI / Swagger"],
  },
  {
    label: "Testing",
    accent: false,
    items: ["Vue Test Utils", "Vitest", "Mocha", "Chai", "TDD"],
  },
];

const marqueeItems = [...frameworks.map((f) => f.name), ...groups.flatMap((g) => g.items)];
---

<section id="skills" class="border-t border-ink-200/60 py-20 dark:border-ink-800/60 md:py-28">
  <div class="mx-auto max-w-5xl px-6">
    <p class="reveal font-mono text-sm text-accent-600 dark:text-accent-400">03 · Skills</p>
    <h2 data-split class="reveal mt-3 text-2xl font-bold tracking-tight text-ink-950 sm:text-3xl dark:text-white">
      Tools I reach for.
    </h2>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        frameworks.map((fw) => (
          <div class="reveal rounded-2xl border border-ink-200 bg-ink-100/40 p-5 dark:border-ink-800 dark:bg-ink-900/40">
            <div class="flex items-center justify-between">
              <p class="font-display text-base font-bold text-ink-950 dark:text-white">{fw.name}</p>
              <div class="flex gap-1" role="img" aria-label={`Proficiency: ${fw.level} out of 5`}>
                {Array.from({ length: 5 }).map((_, i) => (
                  <span
                    class:list={[
                      "h-2 w-2 rounded-full",
                      i < fw.level
                        ? "bg-gradient-to-br from-accent-500 to-violet-500"
                        : "bg-ink-200 dark:bg-ink-800",
                    ]}
                  />
                ))}
              </div>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{fw.note}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="marquee-group reveal mt-10 overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_10%,black_90%,transparent)]">
    <div class="marquee-track flex w-max gap-3">
      {
        Array.from({ length: 2 }).map(() => (
          <>
            {marqueeItems.map((item) => (
              <span class="flex-shrink-0 rounded-full border border-ink-200 bg-ink-100/60 px-4 py-2 font-mono text-sm text-ink-600 dark:border-ink-800 dark:bg-ink-900/40 dark:text-ink-300">
                {item}
              </span>
            ))}
          </>
        ))
      }
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-6">
    <div class="mt-12 grid gap-8 sm:grid-cols-2 md:grid-cols-3">
      {
        groups.map((group) => (
          <div class="reveal">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-ink-500 dark:text-ink-400">
              {group.label}
            </h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span
                  class:list={[
                    "rounded-full border px-3 py-1.5 text-sm font-medium transition-colors",
                    group.accent
                      ? "border-accent-500/30 bg-accent-500/10 text-accent-700 dark:border-accent-400/30 dark:bg-accent-400/10 dark:text-accent-300"
                      : "border-ink-200 bg-ink-100/60 text-ink-600 dark:border-ink-800 dark:bg-ink-900/40 dark:text-ink-300",
                  ]}
                >
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
