---
import Projects from "./Projects.vue";
---

<section id="projects" class="border-t border-ink-200/60 py-20 dark:border-ink-800/60 md:py-28">
  <div class="mx-auto max-w-5xl px-6">
    <p class="reveal font-mono text-sm text-accent-600 dark:text-accent-400">
      <span data-i18n-lang="en" class="i18n-inline">04 · Projects</span>
      <span data-i18n-lang="es" class="i18n-inline">04 · Proyectos</span>
    </p>
    <h2 data-split data-i18n-lang="en" class="reveal mt-3 text-2xl font-bold tracking-tight text-ink-950 sm:text-3xl dark:text-white">
      Selected work.
    </h2>
    <h2 data-split data-i18n-lang="es" class="reveal mt-3 text-2xl font-bold tracking-tight text-ink-950 sm:text-3xl dark:text-white">
      Trabajo seleccionado.
    </h2>

    <div class="reveal mt-10">
      <Projects client:visible />
    </div>
  </div>
</section>
